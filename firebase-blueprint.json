{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student and visitor profile record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "visitorId": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "referralSource": { "type": "string" },
        "promptCount": { "type": "number" },
        "registeredAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "User activity, feature usage and AI interaction log for real analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string" },
        "feature": { "type": "string" },
        "query": { "type": "string" },
        "status": { "type": "string" },
        "errorDetails": { "type": "string" },
        "referral": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["type", "timestamp"]
    },
    "ReferralClick": {
      "title": "ReferralClick",
      "description": "Share link and referral source tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referralCode": { "type": "string" },
        "visitorId": { "type": "string" },
        "referrer": { "type": "string" },
        "timestamp": { "type": "string" },
        "convertedToUser": { "type": "boolean" }
      },
      "required": ["visitorId", "timestamp"]
    },
    "QuizScore": {
      "title": "QuizScore",
      "description": "Student quiz score and assessment metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examCategory": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "score", "totalQuestions"]
    },
    "MistakeItem": {
      "title": "MistakeItem",
      "description": "Student mistake registered for remediation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "userAnswer": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "question", "correctAnswer"]
    },
    "StenoRecord": {
      "title": "StenoRecord",
      "description": "Shorthand practice transcription results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "wpm": { "type": "number" },
        "accuracy": { "type": "number" },
        "passageSystem": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "wpm", "accuracy"]
    },
    "StudentFeedback": {
      "title": "StudentFeedback",
      "description": "Student feedback or content correction report",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["message"]
    },
    "GroupQuizRoom": {
      "title": "GroupQuizRoom",
      "description": "Real-time multiplayer group quiz room session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "status": { "type": "string" },
        "currentQuestionIndex": { "type": "number" },
        "timePerQuestion": { "type": "number" },
        "questionStartTime": { "type": "number" },
        "speakerEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "hostId", "status"]
    },
    "ExamLeaderboardEntry": {
      "title": "ExamLeaderboardEntry",
      "description": "Practice set and exam mock leaderboard ranking entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "examTitle": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "correctCount": { "type": "number" },
        "wrongCount": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "accuracy": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "name", "score", "totalQuestions"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User and visitor profile collection"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time usage and feature analytics logs"
    },
    "/referrals/{refId}": {
      "schema": "ReferralClick",
      "description": "Share-link clicks and referral tracker"
    },
    "/users/{userId}/quiz_scores/{scoreId}": {
      "schema": "QuizScore",
      "description": "User quiz assessment scores"
    },
    "/users/{userId}/mistakes/{mistakeId}": {
      "schema": "MistakeItem",
      "description": "User mistake notebook items"
    },
    "/users/{userId}/steno_records/{recordId}": {
      "schema": "StenoRecord",
      "description": "User shorthand practice and transcription records"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "StudentFeedback",
      "description": "Platform bug and question correction reports"
    },
    "/group_quizzes/{roomId}": {
      "schema": "GroupQuizRoom",
      "description": "Multiplayer live group quiz room state"
    },
    "/exam_leaderboard/{entryId}": {
      "schema": "ExamLeaderboardEntry",
      "description": "Public practice set and test series ranks"
    }
  }
}
