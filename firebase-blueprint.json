{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered student profile and activity tracking for 24h inactivity auto-email alerts",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered student email for 24h study alerts",
          "maxLength": 150
        },
        "targetExam": {
          "type": "string",
          "description": "Student target exam",
          "maxLength": 100
        },
        "streakDays": {
          "type": "number",
          "description": "Current active study streak in days"
        },
        "xpCoins": {
          "type": "number",
          "description": "Total earned XP coins"
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last study activity"
        },
        "autoEmailEnabled": {
          "type": "boolean",
          "description": "Background 24h inactivity email alert flag"
        }
      },
      "required": ["uid", "displayName", "email", "targetExam", "streakDays", "xpCoins", "lastActiveAt", "autoEmailEnabled"]
    },
    "StudyActivity": {
      "title": "StudyActivity",
      "description": "Student learning activity item used to auto-generate personalized EduReels and Analytics",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "feature": {
          "type": "string",
          "description": "Module name (steno, ca, quiz, science, library, board)",
          "maxLength": 60
        },
        "topic": {
          "type": "string",
          "description": "Studied topic or question title",
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "description": "Key takeaway or concept for auto-reel generation",
          "maxLength": 1000
        },
        "scorePercent": {
          "type": "number",
          "description": "Accuracy or score achieved in this activity"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Activity timestamp"
        }
      },
      "required": ["userId", "feature", "topic", "summary", "scorePercent", "createdAt"]
    },
    "AdminBroadcast": {
      "title": "AdminBroadcast",
      "description": "Admin announcements, WhatsApp group config, and live notification items",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "description": "Admin UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Broadcast heading",
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "description": "Broadcast body content",
          "maxLength": 1000
        },
        "whatsappGroupUrl": {
          "type": "string",
          "description": "Official WhatsApp group link",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Broadcast creation timestamp"
        }
      },
      "required": ["authorUid", "title", "message", "whatsappGroupUrl", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile and 24-hour inactivity alert metadata"
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/StudyActivity" },
      "description": "Student study activities for auto-generating EduReels and performance analytics"
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/AdminBroadcast" },
      "description": "Admin announcements and WhatsApp integration settings"
    }
  }
}
