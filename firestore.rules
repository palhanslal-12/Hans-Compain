rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == "palhanslal4@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'targetExam', 'streakDays', 'xpCoins', 'lastActiveAt', 'autoEmailEnabled']) &&
             data.keys().hasOnly(['uid', 'displayName', 'email', 'targetExam', 'streakDays', 'xpCoins', 'lastActiveAt', 'autoEmailEnabled']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.targetExam is string && data.targetExam.size() >= 1 && data.targetExam.size() <= 100 &&
             data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000 &&
             data.xpCoins is number && data.xpCoins >= 0 && data.xpCoins <= 10000000 &&
             data.lastActiveAt is string && data.lastActiveAt.size() >= 10 && data.lastActiveAt.size() <= 60 &&
             data.autoEmailEnabled is bool;
    }

    // Validation Blueprint: StudyActivity
    function isValidStudyActivity(data) {
      return data.keys().hasAll(['userId', 'feature', 'topic', 'summary', 'scorePercent', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'feature', 'topic', 'summary', 'scorePercent', 'createdAt']) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.userId == request.auth.uid &&
             data.feature is string && data.feature.size() >= 1 && data.feature.size() <= 60 &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 200 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1000 &&
             data.scorePercent is number && data.scorePercent >= 0 && data.scorePercent <= 100 &&
             data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 60;
    }

    // Validation Blueprint: AdminBroadcast
    function isValidAdminBroadcast(data) {
      return data.keys().hasAll(['authorUid', 'title', 'message', 'whatsappGroupUrl', 'createdAt']) &&
             data.keys().hasOnly(['authorUid', 'title', 'message', 'whatsappGroupUrl', 'createdAt']) &&
             data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.authorUid == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
             data.whatsappGroupUrl is string && data.whatsappGroupUrl.size() >= 1 && data.whatsappGroupUrl.size() <= 300 &&
             data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 60;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'targetExam', 'streakDays', 'xpCoins', 'lastActiveAt', 'autoEmailEnabled'])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /activities/{activityId} {
      allow get: if isSignedIn() && isValidId(activityId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(activityId) && isValidStudyActivity(incoming());
      allow update: if isVerifiedUser() && isValidId(activityId) && isValidStudyActivity(incoming()) && (
        isAdmin() || (
          resource.data.userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'summary', 'scorePercent'])
        )
      );
      allow delete: if isSignedIn() && isValidId(activityId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /broadcasts/{broadcastId} {
      allow get: if isSignedIn() && isValidId(broadcastId) && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(broadcastId) && isValidAdminBroadcast(incoming());
      allow update: if isAdmin() && isValidId(broadcastId) && isValidAdminBroadcast(incoming()) &&
                    incoming().authorUid == existing().authorUid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'whatsappGroupUrl']);
      allow delete: if isAdmin() && isValidId(broadcastId);
    }
  }
}
